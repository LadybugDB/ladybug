-DATASET CSV empty

--

# A single destination node lets SHORTEST and ALL SHORTEST search from both ends. The expected rows
# are the ones the one-sided search returns.
-CASE SinglePairShortestPath
-STATEMENT CREATE NODE TABLE P(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE Q(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE REL TABLE K(FROM P TO P, w INT64);
---- ok
-STATEMENT CREATE REL TABLE L(FROM P TO Q);
---- ok
-STATEMENT UNWIND range(0, 13) AS i CREATE (:P {id: i});
---- ok
-STATEMENT CREATE (:Q {id: 0}), (:Q {id: 1});
---- ok
# Two paths 0-1-3-4 and 0-2-3-4, with 3-4 doubled, so four shortest paths of length 3, and a
# longer path 0-5-6-7-4. 8 is isolated, 9 hangs off 4, and 10-11-12-13 is a separate chain.
-STATEMENT UNWIND [[0, 1, 1], [0, 2, 2], [1, 3, 2], [2, 3, 2], [3, 4, 2], [3, 4, 3], [0, 5, 2], [5, 6, 2], [6, 7, 2], [7, 4, 2], [4, 9, 2], [10, 11, 2], [11, 12, 2], [12, 13, 2]] AS e
           MATCH (a:P {id: e[1]}), (b:P {id: e[2]}) CREATE (a)-[:K {w: e[3]}]->(b);
---- ok
-STATEMENT MATCH (a:P {id: 9}), (q:Q {id: 1}) CREATE (a)-[:L]->(q);
---- ok
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 4}) MATCH p = (a)-[:K* SHORTEST 1..5]-(b) RETURN length(p);
---- 1
3
-STATEMENT MATCH (a:P {id: 4}), (b:P {id: 0}) MATCH p = (a)-[:K* SHORTEST 1..5]-(b) RETURN length(p), size(rels(p));
---- 1
3|3
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 4}) MATCH p = (a)-[:K* ALL SHORTEST 1..5]-(b) RETURN properties(nodes(p), 'id'), properties(rels(p), 'w');
---- 4
[0,1,3,4]|[1,2,2]
[0,1,3,4]|[1,2,3]
[0,2,3,4]|[2,2,2]
[0,2,3,4]|[2,2,3]
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 4}) MATCH (a)-[e:K* ALL SHORTEST 1..5]-(b) RETURN length(e), count(*);
---- 1
3|4
-STATEMENT MATCH (a:P {id: 0}), (b:P) WHERE b.id IN [4, 9] MATCH (a)-[e:K* ALL SHORTEST 1..5]-(b) RETURN b.id, length(e), count(*);
---- 2
4|3|4
9|4|4
# Directed searches scan the destination's side against the query direction.
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 9}) MATCH p = (a)-[:K* ALL SHORTEST 1..5]->(b) RETURN properties(nodes(p), 'id');
---- 4
[0,1,3,4,9]
[0,1,3,4,9]
[0,2,3,4,9]
[0,2,3,4,9]
-STATEMENT MATCH (a:P {id: 9}), (b:P {id: 0}) MATCH p = (a)-[:K* SHORTEST 1..5]->(b) RETURN length(p);
---- 0
-STATEMENT MATCH (a:P {id: 9}), (b:P {id: 0}) MATCH p = (a)<-[:K* SHORTEST 1..5]-(b) RETURN length(p);
---- 1
4
# The chain is stored 10 -> 11 -> 12 -> 13, so a path from 13 walks each edge against its direction.
-STATEMENT MATCH (a:P {id: 13}), (b:P {id: 10}) MATCH p = (a)-[:K* SHORTEST 1..5]-(b) RETURN properties(nodes(p), 'id'), rels(p);
---- 1
[13,12,11,10]|[(0:12)-{_LABEL: K, _ID: 2:13, w: 2}->(0:13),(0:11)-{_LABEL: K, _ID: 2:12, w: 2}->(0:12),(0:10)-{_LABEL: K, _ID: 2:11, w: 2}->(0:11)]
-STATEMENT MATCH (a:P {id: 0}), (q:Q {id: 1}) MATCH p = (a)-[:K|:L* SHORTEST 1..6]->(q) RETURN length(p);
---- 1
5
# The source is exempt from the node predicate, as in the one-sided search, and the destination
# is not.
-STATEMENT MATCH (a:P {id: 10}), (b:P {id: 13}) MATCH p = (a)-[:K* SHORTEST 1..3 (r, n | WHERE n.id > 10)]-(b) RETURN length(p);
---- 1
3
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 4}) MATCH p = (a)-[:K* ALL SHORTEST 1..5 (r, n | WHERE n.id <> 3)]-(b) RETURN properties(nodes(p), 'id');
---- 1
[0,5,6,7,4]
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 4}) MATCH p = (a)-[:K* SHORTEST 1..5 (r, n | WHERE n.id <> 4)]-(b) RETURN length(p);
---- 0
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 4}) MATCH p = (a)-[:K* ALL SHORTEST 1..5 (r, n | WHERE r.w > 1)]-(b) RETURN properties(nodes(p), 'id'), properties(rels(p), 'w');
---- 2
[0,2,3,4]|[2,2,2]
[0,2,3,4]|[2,2,3]
# No path within the bound, and no path at all.
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 4}) MATCH p = (a)-[:K* SHORTEST 1..2]-(b) RETURN length(p);
---- 0
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 4}) MATCH (a)-[e:K* ALL SHORTEST 1..2]-(b) RETURN count(*);
---- 1
0
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 8}) OPTIONAL MATCH p = (a)-[:K* SHORTEST 1..5]-(b) RETURN coalesce(length(p), -1);
---- 1
-1
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 13}) MATCH (a)-[e:K* ALL SHORTEST 1..5]-(b) RETURN count(*);
---- 1
0

# ALL SHORTEST paths that end in the second node table.
-STATEMENT MATCH (a:P {id: 0}), (q:Q {id: 1}) MATCH p = (a)-[:K|:L* ALL SHORTEST 1..6]->(q) RETURN properties(nodes(p), 'id'), count(*);
---- 2
[0,1,3,4,9,1]|2
[0,2,3,4,9,1]|2
# Uncommitted changes: with node 3 deleted only the detour is left, and a self-loop adds no path.
-STATEMENT BEGIN TRANSACTION;
---- ok
-STATEMENT MATCH (n:P {id: 3}) DETACH DELETE n;
---- ok
-STATEMENT MATCH (a:P {id: 5}) CREATE (a)-[:K {w: 7}]->(a);
---- ok
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 4}) MATCH p = (a)-[:K* ALL SHORTEST 1..5]-(b) RETURN properties(nodes(p), 'id');
---- 1
[0,5,6,7,4]
-STATEMENT MATCH (a:P {id: 5}), (b:P {id: 6}) MATCH (a)-[e:K* ALL SHORTEST 1..3]-(b) RETURN length(e), count(*);
---- 1
1|1
-STATEMENT ROLLBACK;
---- ok
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 4}) MATCH (a)-[e:K* ALL SHORTEST 1..5]-(b) RETURN length(e), count(*);
---- 1
3|4

# A rel table stored forward only cannot be walked backward from the destination, so these pairs
# keep the one-sided search.
-CASE SinglePairForwardOnlyStorage
-STATEMENT CREATE NODE TABLE P(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE REL TABLE K(FROM P TO P) WITH (storage_direction = 'fwd');
---- ok
-STATEMENT UNWIND range(0, 9) AS i CREATE (:P {id: i});
---- ok
-STATEMENT UNWIND [[0, 1], [1, 2], [2, 3], [0, 4], [4, 3]] AS e MATCH (a:P {id: e[1]}), (b:P {id: e[2]}) CREATE (a)-[:K]->(b);
---- ok
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 3}) MATCH p = (a)-[:K* SHORTEST 1..5]->(b) RETURN length(p);
---- 1
2
-STATEMENT MATCH (a:P {id: 0}), (b:P {id: 3}) MATCH p = (a)-[:K* ALL SHORTEST 1..5]->(b) RETURN properties(nodes(p), 'id');
---- 1
[0,4,3]
-STATEMENT MATCH (a:P {id: 3}), (b:P {id: 0}) MATCH p = (a)<-[:K* SHORTEST 1..5]-(b) RETURN length(p);
---- 1
2

-CASE SinglePairFallsBackToOneSidedSearch
# Before the two ends meet on the chain between them, each reaches a 200-node clique with an edge
# each way between every two of its nodes. Expanding one clique scans about 80,000 edges, more than
# MAX_SCANNED_EDGES in bidirectional_sp.cpp, so the one-sided search answers.
-STATEMENT CREATE NODE TABLE C(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE REL TABLE CE(FROM C TO C);
---- ok
-STATEMENT UNWIND range(0, 199) AS i CREATE (:C {id: i});
---- ok
-STATEMENT UNWIND range(1000, 1199) AS i CREATE (:C {id: i});
---- ok
-STATEMENT UNWIND [2000, 2001, 2002, 2003, 3000, 3001] AS i CREATE (:C {id: i});
---- ok
-STATEMENT MATCH (a:C), (b:C) WHERE a.id < 200 AND b.id < 200 AND a.id <> b.id CREATE (a)-[:CE]->(b);
---- ok
-STATEMENT MATCH (a:C), (b:C) WHERE a.id >= 1000 AND a.id < 1200 AND b.id >= 1000 AND b.id < 1200 AND a.id <> b.id CREATE (a)-[:CE]->(b);
---- ok
-STATEMENT UNWIND [[199, 2000], [2000, 2001], [2001, 2002], [2002, 2003], [2003, 1199], [3000, 1], [3000, 2], [3000, 3], [1001, 3001], [1002, 3001]] AS e MATCH (a:C {id: e[1]}), (b:C {id: e[2]}) CREATE (a)-[:CE]->(b);
---- ok
-STATEMENT MATCH (a:C {id: 3000}), (b:C {id: 3001}) MATCH p = (a)-[:CE* SHORTEST 1..10]-(b) RETURN length(p), properties(nodes(p), 'id')[3], properties(nodes(p), 'id')[8];
---- 1
9|199|1199
-STATEMENT MATCH (a:C {id: 3000}), (b:C {id: 3001}) MATCH (a)-[e:CE* ALL SHORTEST 1..10]-(b) RETURN length(e), count(*);
---- 1
9|24
-STATEMENT MATCH (a:C {id: 3000}), (b:C {id: 3001}) MATCH p = (a)-[:CE* ALL SHORTEST 1..10]-(b) RETURN properties(nodes(p), 'id'), count(*);
---- 6
[3000,1,199,2000,2001,2002,2003,1199,1001,3001]|4
[3000,1,199,2000,2001,2002,2003,1199,1002,3001]|4
[3000,2,199,2000,2001,2002,2003,1199,1001,3001]|4
[3000,2,199,2000,2001,2002,2003,1199,1002,3001]|4
[3000,3,199,2000,2001,2002,2003,1199,1001,3001]|4
[3000,3,199,2000,2001,2002,2003,1199,1002,3001]|4
-STATEMENT MATCH (a:C {id: 3000}), (b:C {id: 3001}) MATCH p = (a)-[:CE* SHORTEST 1..8]-(b) RETURN length(p);
---- 0
-STATEMENT MATCH (a:C {id: 3000}), (b:C {id: 3001}) MATCH (a)-[e:CE* ALL SHORTEST 1..8]-(b) RETURN count(*);
---- 1
0
