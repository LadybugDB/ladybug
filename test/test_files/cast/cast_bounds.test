-CASE double
-STATEMENT RETURN CAST("1.7976931348623157e308" AS DOUBLE) = 1.7976931348623157e308
---- 1
True
-STATEMENT RETURN CAST("4.9e-324" AS DOUBLE) > 0
---- 1
True
-LOG DoubleOverflowIsInfinity
-STATEMENT RETURN CAST("1.8e308" AS DOUBLE)
---- 1
inf
-STATEMENT RETURN CAST("-1.8e308" AS DOUBLE)
---- 1
-inf
-LOG DoubleUnderflowIsZero
-STATEMENT RETURN CAST("1e-400" AS DOUBLE) = 0
---- 1
True

-CASE float
-STATEMENT RETURN CAST("3.4028235e38" AS FLOAT) = CAST(3.4028235e38 AS FLOAT)
---- 1
True
-STATEMENT RETURN CAST("1.4e-45" AS FLOAT) > 0
---- 1
True
-LOG FloatOverflowIsInfinity
-STATEMENT RETURN CAST("1e39" AS FLOAT)
---- 1
inf
-STATEMENT RETURN CAST("-1e39" AS FLOAT)
---- 1
-inf
-LOG FloatUnderflowIsZero
-STATEMENT RETURN CAST("1e-50" AS FLOAT) = 0
---- 1
True

-CASE timestamp_ns
-LOG TimestampNsInRange
-STATEMENT RETURN CAST(CAST('2020-01-02 03:04:05.123456789' AS TIMESTAMP_NS) AS STRING)
---- 1
2020-01-02 03:04:05.123456
-STATEMENT RETURN CAST(CAST('2262-04-11 23:47:16.854775807' AS TIMESTAMP_NS) AS STRING)
---- 1
2262-04-11 23:47:16.854775
-LOG TimestampNsOutOfRange
-STATEMENT RETURN CAST('9999-01-01 00:00:00' AS TIMESTAMP_NS)
---- error
Overflow exception: Value 253370764800000000 * 1000 is not within INT64 range.
-STATEMENT RETURN CAST(CAST('9999-01-01 00:00:00' AS TIMESTAMP) AS TIMESTAMP_NS)
---- error
Overflow exception: Value 253370764800000000 * 1000 is not within INT64 range.
-STATEMENT RETURN CAST(CAST('9999-01-01' AS DATE) AS TIMESTAMP_NS)
---- error
Overflow exception: Value 253370764800000000 * 1000 is not within INT64 range.
-STATEMENT RETURN CAST(CAST('1600-01-01 00:00:00' AS TIMESTAMP) AS TIMESTAMP_NS)
---- error
Overflow exception: Value -11676096000000000 * 1000 is not within INT64 range.

-CASE timestamp_ns_trycast
-LOG TimestampNsTryCastOverflowReturnsFailure
-STATEMENT WITH CAST('9999-01-01 00:00:00' AS UNION(ns TIMESTAMP_NS, s STRING)) AS u RETURN u, union_tag(u);
---- 1
9999-01-01 00:00:00|s
-STATEMENT WITH CAST('2020-01-02 03:04:05.123456789' AS UNION(ns TIMESTAMP_NS, s STRING)) AS u RETURN u, union_tag(u);
---- 1
2020-01-02 03:04:05.123456|ns
-STATEMENT RETURN CAST('9999-01-01 00:00:00' AS UNION(ns TIMESTAMP_NS));
---- error
Conversion exception: Could not convert to union type UNION(ns TIMESTAMP_NS): 9999-01-01 00:00:00.
