-DATASET CSV empty

--

-CASE ExpressionOverRemovedDistinct
-STATEMENT CREATE NODE TABLE P(id INT64 PRIMARY KEY, flag BOOLEAN)
---- ok
-STATEMENT CREATE (:P {id: 1, flag: true}), (:P {id: 2, flag: false}), (:P {id: 3, flag: true}), (:P {id: 4})
---- ok
-LOG n.flag depends on the key n.id, so the first DISTINCT has only primary keys and is removed
-STATEMENT MATCH (n:P) WITH DISTINCT n.id AS v, n.flag AS f WITH DISTINCT CASE WHEN f THEN v ELSE 1 END AS w RETURN w
---- 2
1
3
-STATEMENT MATCH (n:P) WITH DISTINCT n.id AS v WITH DISTINCT coalesce(v, 0) AS w RETURN w
---- 4
1
2
3
4
-STATEMENT MATCH (n:P) WITH DISTINCT n.id AS v RETURN DISTINCT coalesce(v, 0) AS w
---- 4
1
2
3
4
-STATEMENT MATCH (n:P) WITH DISTINCT n.id AS v WITH DISTINCT [v] AS w RETURN w
---- 4
[1]
[2]
[3]
[4]
-STATEMENT MATCH (n:P) WITH DISTINCT n.id AS v WITH DISTINCT v + 1 AS w RETURN w
---- 4
2
3
4
5
-STATEMENT MATCH (n:P) WITH DISTINCT n.id AS v MATCH (m:P) WHERE m.id = v + 1 RETURN count(*)
---- 1
3
-STATEMENT MATCH (n:P) WITH DISTINCT n.id AS v UNWIND [v, v + 1] AS x RETURN count(DISTINCT x)
---- 1
5
-STATEMENT MATCH (n:P) WITH DISTINCT n.id AS v RETURN [v] AS w UNION ALL MATCH (n:P) WHERE n.id = 1 RETURN [n.id] AS w
---- 5
[1]
[1]
[2]
[3]
[4]
