-LOG OptionalShortestPathIsNull
-STATEMENT MATCH (a:person), (b:person) WHERE a.ID = 0 AND b.ID IN [3, 7] OPTIONAL MATCH p = (a)-[r:knows* SHORTEST 1..5]-(b) RETURN b.ID, p IS NULL, r IS NULL, length(p), CASE WHEN p IS NULL THEN -1 ELSE length(p) END
