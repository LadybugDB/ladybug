-DATASET CSV empty
--

-CASE CSRHeaderSpan
# One thread keeps each hub's list a separate batch of bound nodes for the E scan.
-STATEMENT CALL threads=1;
---- ok
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N);
---- ok
-STATEMENT CREATE REL TABLE F(FROM N TO N);
---- ok
-STATEMENT UNWIND range(0, 5999) AS i CREATE (:N {id: i});
---- ok
-STATEMENT MATCH (a:N) WHERE a.id % 3 <> 0 UNWIND [(a.id * 7 + 1) % 6000, (a.id * 13 + 5) % 6000] AS t MATCH (b:N {id: t}) CREATE (a)-[:E]->(b);
---- ok
-STATEMENT MATCH (h:N), (a:N) WHERE h.id = 0 AND a.id >= 100 AND a.id < 200 AND a.id < 6000 CREATE (h)-[:F]->(a);
---- ok
-STATEMENT MATCH (h:N), (a:N) WHERE h.id = 1 AND a.id >= 150 AND a.id < 160 AND a.id < 6000 CREATE (h)-[:F]->(a);
---- ok
-STATEMENT MATCH (h:N), (a:N) WHERE h.id = 2 AND a.id >= 4000 AND a.id < 4100 AND a.id < 6000 CREATE (h)-[:F]->(a);
---- ok
-STATEMENT MATCH (h:N), (a:N) WHERE h.id = 3 AND a.id IN [0, 5999] CREATE (h)-[:F]->(a);
---- ok
