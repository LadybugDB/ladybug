-STATEMENT CREATE NODE TABLE L(id INT64, k INT64, l INT64[], a INT64[2], s STRING, PRIMARY KEY(id));
---- ok
-STATEMENT UNWIND range(0, 4095) AS i CREATE (:L {id: i, k: CASE WHEN i IN [3, 5, 2048, 2055] THEN 1 ELSE 0 END, l: [i, i + 1], a: [i, 2 * i], s: 'l' + string(i)});
---- ok
-STATEMENT CREATE NODE TABLE D(id INT64, x INT64, s STRING, PRIMARY KEY(id));
