-DATASET CSV tinysnb
--

-CASE StatsInfo
-STATEMENT MATCH (p:person) RETURN COUNT(p)
---- 1
8
-STATEMENT CALL stats_info('person') RETURN cardinality, gender_distinct_count
---- 1
8|2
-STATEMENT CALL stats_info('not_exist') RETURN *
---- error
Binder exception: Table not_exist does not exist!
-STATEMENT CALL stats_info('knows') RETURN *
---- error
Binder exception: Stats from a non-node table knows is not supported yet!
-RELOADDB
-STATEMENT CREATE (p:person {id: 10000});
---- ok
-STATEMENT CALL stats_info('person') RETURN cardinality, gender_distinct_count
---- 1
9|3

# distinct count is not stored for nested types
-STATEMENT CALL stats_info('person') RETURN cardinality, workedHours_distinct_count
---- 1
9|0

-CASE StatsInfoWithTransaction
-STATEMENT CALL stats_info('person') RETURN cardinality, gender_distinct_count
---- 1
8|2
-STATEMENT BEGIN TRANSACTION;
---- ok
-STATEMENT CREATE (p:person {id: 10000, fName: "Alice"});
---- ok
-STATEMENT CALL stats_info('person') RETURN cardinality, gender_distinct_count
---- 1
9|3

# Distinct count isn't exact so we give a range here
-STATEMENT CALL stats_info('person') WHERE fName_distinct_count > 5 AND fName_distinct_count <= 9 RETURN cardinality
---- 1
9

-STATEMENT ROLLBACK;
---- ok
-STATEMENT CALL stats_info('person') RETURN cardinality, gender_distinct_count
---- 1
8|2

-CASE AddNodeProperty
-STATEMENT create node table Comment (id int64, PRIMARY KEY (id));
---- ok
-STATEMENT copy Comment from '${LBUG_ROOT_DIRECTORY}/dataset/lsqb-sf01/Comment.csv' (HEADER=true);
---- ok
-STATEMENT alter table Comment add propx int64;
---- ok
-STATEMENT alter table Comment add propy int64 default 1;
---- ok
-STATEMENT CALL stats_info('Comment') RETURN cardinality, propx_distinct_count, propy_distinct_count
---- 1
215488|1|1

-CASE StatsInfoAfterDropAndRolledBackAdd
-STATEMENT CREATE NODE TABLE T(id INT64 PRIMARY KEY, a INT64, b INT64, c INT64);
---- ok
-STATEMENT CREATE (:T {id: 1, a: 7, b: 10, c: 100}), (:T {id: 2, a: 7, b: 10, c: 200}),
                  (:T {id: 3, a: 7, b: 20, c: 300}), (:T {id: 4, a: 7, b: 20, c: 300});
---- ok
-STATEMENT ALTER TABLE T DROP a;
---- ok
-STATEMENT CALL stats_info('T') RETURN *;
---- 1
4|4|2|3
-STATEMENT ALTER TABLE T ADD d INT64 DEFAULT 5;
---- ok
-STATEMENT CALL stats_info('T') RETURN *;
---- 1
4|4|2|3|1
-STATEMENT CREATE NODE TABLE U(id INT64 PRIMARY KEY, b INT64);
---- ok
-STATEMENT CREATE (:U {id: 1, b: 10}), (:U {id: 2, b: 10}), (:U {id: 3, b: 20});
---- ok
-STATEMENT BEGIN TRANSACTION;
---- ok
-STATEMENT ALTER TABLE U ADD e INT64;
---- ok
-STATEMENT ROLLBACK;
---- ok
-STATEMENT CALL stats_info('U') RETURN *;
---- 1
3|3|2

-CASE StatsInfoWithUncommittedInsertAfterDrop
-STATEMENT CREATE NODE TABLE T(id INT64 PRIMARY KEY, a INT64, b INT64, c INT64);
---- ok
-STATEMENT CREATE (:T {id: 1, a: 7, b: 10, c: 100}), (:T {id: 2, a: 7, b: 10, c: 200}),
                  (:T {id: 3, a: 7, b: 20, c: 300});
---- ok
-STATEMENT ALTER TABLE T DROP a;
---- ok
-STATEMENT BEGIN TRANSACTION;
---- ok
# The pending c value repeats a committed b value, so counting it under b's column changes b's
# count.
-STATEMENT CREATE (:T {id: 4, b: 30, c: 10});
---- ok
-STATEMENT CALL stats_info('T') RETURN *;
---- 1
4|4|3|4
-STATEMENT COMMIT;
---- ok
-STATEMENT CALL stats_info('T') RETURN *;
---- 1
4|4|3|4

-CASE StatsInfoWithInsertThenDropInTransaction
-STATEMENT CREATE NODE TABLE T(id INT64 PRIMARY KEY, a INT64, b INT64, c INT64);
---- ok
-STATEMENT CREATE (:T {id: 1, a: 7, b: 10, c: 100}), (:T {id: 2, a: 7, b: 10, c: 200}),
                  (:T {id: 3, a: 7, b: 20, c: 300});
---- ok
-STATEMENT BEGIN TRANSACTION;
---- ok
# The pending row keeps its a value after the DROP. Its c value repeats a committed b value, so
# counting the row's columns under the wrong storage columns changes b's count.
-STATEMENT CREATE (:T {id: 4, a: 10, b: 30, c: 10});
---- ok
-STATEMENT ALTER TABLE T DROP a;
---- ok
-STATEMENT CALL stats_info('T') RETURN *;
---- 1
4|4|3|4
-STATEMENT ROLLBACK;
---- ok

-CASE StatsInfoWithAddInTransactionAfterRolledBackAdd
-STATEMENT CREATE NODE TABLE T(id INT64 PRIMARY KEY, b INT64);
---- ok
-STATEMENT CREATE (:T {id: 1, b: 10}), (:T {id: 2, b: 10}), (:T {id: 3, b: 20});
---- ok
-STATEMENT BEGIN TRANSACTION;
---- ok
-STATEMENT ALTER TABLE T ADD e INT64 DEFAULT 9;
---- ok
-STATEMENT ROLLBACK;
---- ok
-STATEMENT BEGIN TRANSACTION;
---- ok
# The rolled-back ADD leaves a storage column behind, so z's catalog column ID is not the position
# of the storage column the second ADD appends. e and z share a default, so the counts don't depend
# on which of the two the committed rows read.
-STATEMENT CREATE (:T {id: 4, b: 30});
---- ok
-STATEMENT ALTER TABLE T ADD z INT64 DEFAULT 9;
---- ok
-STATEMENT CREATE (:T {id: 5, b: 30, z: 11});
---- ok
-STATEMENT CALL stats_info('T') RETURN *;
---- 1
5|5|3|2
-STATEMENT COMMIT;
---- ok
-STATEMENT CALL stats_info('T') RETURN *;
---- 1
5|5|3|2
