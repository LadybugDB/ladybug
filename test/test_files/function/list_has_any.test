True
-STATEMENT CREATE NODE TABLE Member(name STRING, aliases STRING[], scores INT64[], PRIMARY KEY(name));
---- ok
-STATEMENT CREATE (:Member {name: 'Alice', aliases: ['Aida'], scores: [96,54,86,92]});
---- ok
-STATEMENT CREATE (:Member {name: 'Bob', aliases: ['Bobby'], scores: [98,42,93,88]});
---- ok
-STATEMENT CREATE (:Member {name: 'Carol', aliases: ['Carmen', 'Fred'], scores: [91,75,21,95]});
---- ok
-STATEMENT MATCH (p:Member) WHERE p.name = 'Alice' RETURN list_has_any(p.aliases, ['Aida'])
---- 1
True
-STATEMENT MATCH (p:Member) WHERE p.name = 'Alice' RETURN list_has_any(p.aliases, ['Bobby'])
---- 1
False
-STATEMENT MATCH (p:Member) WHERE p.name = 'Alice' RETURN list_has_any(p.aliases, ['Aida', 'Bobby'])
---- 1
True
-STATEMENT MATCH (p:Member) WHERE p.name = 'Bob' RETURN list_has_any(p.aliases, ['Aida', 'Bobby'])
---- 1
True
-STATEMENT MATCH (p:Member) WHERE p.name = 'Carol' RETURN list_has_any(p.aliases, ['Aida', 'Bobby'])
---- 1
False
