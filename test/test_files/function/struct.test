-CASE StructExtractOfNullStruct

-LOG FieldOfNullLiteral
-STATEMENT RETURN CAST(NULL AS STRUCT(day DATE)).day IS NULL
---- 1
True

-STATEMENT CREATE NODE TABLE ns(id INT64 PRIMARY KEY, s STRUCT(t STRUCT(day DATE, n INT64), name STRING))
---- ok
-STATEMENT CREATE (:ns {id: 1, s: {t: {day: date('2021-01-02'), n: 5}, name: 'a'}})
---- ok
-STATEMENT CREATE (:ns {id: 2, s: {t: NULL, name: 'b'}})
---- ok
-STATEMENT CREATE (:ns {id: 3, s: NULL})
---- ok

-LOG FieldsOfNullStructs
-STATEMENT MATCH (x:ns) RETURN x.id, x.s.t IS NULL, x.s.t.day IS NULL, x.s.t.n IS NULL, x.s.name IS NULL ORDER BY x.id
---- 3
1|False|False|False|False
2|True|True|True|False
3|True|True|True|True

-LOG AggregatesSkipFieldsOfNullStructs
-STATEMENT MATCH (x:ns) RETURN count(x.s.t.day), min(x.s.t.day), sum(x.s.t.n)
---- 1
1|2021-01-02|5

-LOG FieldsOfNullNodeAndRel
-STATEMENT CREATE REL TABLE nk(FROM ns TO ns, w INT64)
---- ok
-STATEMENT MATCH (a:ns {id: 1}), (b:ns {id: 2}) CREATE (a)-[:nk {w: 7}]->(b)
---- ok
-STATEMENT MATCH (x:ns) OPTIONAL MATCH (x)-[r:nk]->(y:ns) UNWIND [y] AS n UNWIND [r] AS e RETURN x.id, n.id IS NULL, n.s.name IS NULL, e.w IS NULL ORDER BY x.id
---- 3
1|False|False|False
2|True|True|True
3|True|True|True

-LOG FieldsOfNullStructsAfterCheckpoint
-STATEMENT CHECKPOINT
---- ok
-STATEMENT MATCH (x:ns {id: 2}) RETURN x.s, x.s.t IS NULL, x.s.t.day IS NULL
---- 1
{t: , name: b}|True|True
-STATEMENT MATCH (x:ns) RETURN x.id, x.s.t IS NULL, x.s.t.day IS NULL, x.s.t.n IS NULL, x.s.name IS NULL ORDER BY x.id
---- 3
1|False|False|False|False
2|True|True|True|False
3|True|True|True|True

-LOG NullStructDoesNotLeakIntoNextLookupBatch
-STATEMENT CREATE NODE TABLE nl(id INT64 PRIMARY KEY, s STRUCT(name STRING, t STRUCT(n INT64)))
---- ok
-STATEMENT UNWIND range(1, 2048) AS i CREATE (:nl {id: i, s: NULL})
---- ok
-STATEMENT UNWIND range(2049, 4096) AS i CREATE (:nl {id: i, s: {name: 'v', t: {n: 1}}})
---- ok
-STATEMENT CREATE (:nl {id: 4097, s: {name: 'w', t: NULL}})
---- ok
-STATEMENT CHECKPOINT
---- ok
-STATEMENT UNWIND range(1, 4097) AS i MATCH (x:nl {id: i}) RETURN x.s IS NULL, x.s.name IS NULL, x.s.t IS NULL, x.s.t.n IS NULL, count(*)
---- 3
True|True|True|True|2048
False|False|False|False|2048
False|False|True|True|1

-CASE FieldsOfNullStructsFromEveryProducer
-STATEMENT CREATE NODE TABLE ps(id INT64 PRIMARY KEY, s STRUCT(a INT64, t STRUCT(n INT64)))
---- ok
-STATEMENT CREATE NODE TABLE po(id INT64 PRIMARY KEY)
---- ok
-STATEMENT CREATE (:ps {id: 1, s: {a: 1, t: {n: 10}}}), (:ps {id: 2, s: NULL}), (:ps {id: 3, s: {a: 3, t: {n: 30}}})
---- ok
-STATEMENT CREATE (:po {id: 4}), (:po {id: 5})
---- ok

-LOG Unwind
-STATEMENT UNWIND [{a: 1, t: {n: 10}}, NULL, {a: 3, t: {n: 30}}] AS s RETURN s.a IS NULL, s.t.n IS NULL, count(*)
---- 2
False|False|2
True|True|1

-LOG ListExtract
-STATEMENT WITH [{a: 1}, NULL] AS l WITH l[1] AS first, l[2] AS second RETURN first.a, second.a IS NULL
---- 1
1|True

-LOG CaseAndCoalesce
-STATEMENT MATCH (x:ps) RETURN x.id, (CASE WHEN x.id > 0 THEN x.s ELSE NULL END).t.n IS NULL, coalesce(x.s, NULL).a IS NULL ORDER BY x.id
---- 3
1|False|False
2|True|True
3|False|False

-LOG OrderByRoundTrip
-STATEMENT MATCH (x:ps) WITH x.s AS s, x.id AS id ORDER BY id DESC LIMIT 10 RETURN id, s.a IS NULL, s.t.n IS NULL
---- 3
3|False|False
2|True|True
1|False|False

-LOG MultiLabelScanWithoutTheProperty
-STATEMENT MATCH (x:ps:po) RETURN x.s.a IS NULL, x.s.t.n IS NULL, count(*)
---- 2
False|False|2
True|True|3

-LOG NullUnionHasNoTag
-STATEMENT CREATE NODE TABLE pu(id INT64 PRIMARY KEY, u UNION(a INT64, b STRING))
---- ok
-STATEMENT CREATE (:pu {id: 1, u: union_value(a := 1)}), (:pu {id: 2})
---- ok
-STATEMENT MATCH (x:pu) RETURN x.id, union_tag(x.u) IS NULL ORDER BY x.id
---- 2
1|False
2|True

-LOG FieldsOfOptionalMatchNullNode
-STATEMENT CREATE REL TABLE pk(FROM ps TO ps)
---- ok
-STATEMENT MATCH (a:ps {id: 1}), (b:ps {id: 3}) CREATE (a)-[:pk]->(b)
---- ok
-STATEMENT MATCH (x:ps) OPTIONAL MATCH (x)-[:pk]->(y:ps) RETURN x.id, y.id IS NULL, y.s.t.n IS NULL ORDER BY x.id
---- 3
1|False|False
2|True|True
3|True|True

-LOG ListOfStructs
-STATEMENT CREATE NODE TABLE pl(id INT64 PRIMARY KEY, l STRUCT(a INT64)[])
---- ok
-STATEMENT CREATE (:pl {id: 1, l: [{a: 1}, NULL]})
---- ok
-STATEMENT MATCH (x:pl) WITH x.l[1] AS first, x.l[2] AS second RETURN first.a, second.a IS NULL
---- 1
1|True

-LOG AfterCheckpoint
-STATEMENT CHECKPOINT
---- ok
-STATEMENT MATCH (x:ps) RETURN x.id, (CASE WHEN x.id > 0 THEN x.s ELSE NULL END).t.n IS NULL, coalesce(x.s, NULL).a IS NULL ORDER BY x.id
---- 3
1|False|False
2|True|True
3|False|False
-STATEMENT MATCH (x:ps {id: 2}) RETURN x.s.a IS NULL, x.s.t.n IS NULL
---- 1
True|True
-STATEMENT MATCH (x:ps:po) RETURN x.s.a IS NULL, x.s.t.n IS NULL, count(*)
---- 2
False|False|2
True|True|3
-STATEMENT MATCH (x:pu) RETURN x.id, union_tag(x.u) IS NULL ORDER BY x.id
---- 2
1|False
2|True
-STATEMENT MATCH (x:ps) OPTIONAL MATCH (x)-[:pk]->(y:ps) RETURN x.id, y.id IS NULL, y.s.t.n IS NULL ORDER BY x.id
---- 3
1|False|False
2|True|True
3|True|True
-STATEMENT MATCH (x:pl) WITH x.l[1] AS first, x.l[2] AS second RETURN first.a, second.a IS NULL
---- 1
1|True

-LOG AfterWalReplay
-STATEMENT CALL force_checkpoint_on_close=false
---- ok
-STATEMENT CALL auto_checkpoint=false
---- ok
-STATEMENT CREATE (:ps {id: 6, s: NULL})
---- ok
-RELOADDB
-STATEMENT MATCH (x:ps {id: 6}) RETURN x.s IS NULL, x.s.a IS NULL, x.s.t.n IS NULL
---- 1
True|True|True
