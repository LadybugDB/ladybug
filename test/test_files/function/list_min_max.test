-STATEMENT RETURN list_min([date('2020-01-02'), date('2019-12-31'), date('2020-01-01')]), list_max([date('2020-01-02'), date('2019-12-31'), date('2020-01-01')])
---- 1
2019-12-31|2020-01-02
-STATEMENT RETURN list_min([true, false, true]), list_max([true, false, true])
---- 1
False|True
-STATEMENT CREATE NODE TABLE Member(name STRING, aliases STRING[], scores INT64[], PRIMARY KEY(name));
---- ok
-STATEMENT CREATE (:Member {name: 'Alice', aliases: ['Aida'], scores: [96,54,86,92]});
---- ok
-STATEMENT MATCH (p:Member) WHERE p.name = 'Alice' RETURN list_min(p.scores), list_max(p.scores)
---- 1
54|96
-STATEMENT MATCH (p:Member) WHERE p.name = 'Alice' RETURN list_min(p.aliases), list_max(p.aliases)
---- 1
Aida|Aida
