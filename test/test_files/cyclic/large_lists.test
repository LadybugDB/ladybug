-DATASET CSV empty

--

-CASE IntersectListsLongerThanOneVector
-STATEMENT CREATE NODE TABLE N(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N);
---- ok
-STATEMENT UNWIND range(0, 3000) AS i CREATE (:N {id: i});
---- ok
# Node 0 points at the other 3000 nodes, so its list is split over two 2048-entry build tuples
# and a single probe intersects several list pairs.
-STATEMENT MATCH (h:N {id: 0}), (n:N) WHERE n.id > 0 CREATE (h)-[:E]->(n);
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id > 0 AND b.id = a.id + 1 CREATE (a)-[:E]->(b);
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE a.id > 0 AND b.id = a.id + 2 CREATE (a)-[:E]->(b);
---- ok
-LOG Triangle
-STATEMENT MATCH (a:N)-[e1:E]->(b:N)-[e2:E]->(c:N), (a)-[e3:E]->(c)
           HINT (((a JOIN e1) JOIN b) MULTI_JOIN e2 MULTI_JOIN e3) JOIN c
           RETURN COUNT(*);
---- 1
8995
-STATEMENT MATCH (a:N)-[e1:E]->(b:N)-[e2:E]->(c:N), (a)-[e3:E]->(c)
           HINT (((a JOIN e1) JOIN b) MULTI_JOIN e2 MULTI_JOIN e3) JOIN c
           RETURN a.id, b.id, c.id ORDER BY c.id DESC, b.id DESC LIMIT 3;
---- 3
0|2999|3000
2998|2999|3000
0|2998|3000
-LOG FourClique
-STATEMENT MATCH (a:N)-[e1:E]->(b:N)-[e2:E]->(c:N), (a)-[e3:E]->(c), (a)-[e4:E]->(d:N), (b)-[e5:E]->(d), (c)-[e6:E]->(d)
           HINT (((((a JOIN e1) JOIN b) MULTI_JOIN e2 MULTI_JOIN e3) JOIN c) MULTI_JOIN e4 MULTI_JOIN e5 MULTI_JOIN e6) JOIN d
           RETURN COUNT(*), SUM(a.id + b.id * 3 + c.id * 5 + d.id * 7);
---- 1
2998|67489477
