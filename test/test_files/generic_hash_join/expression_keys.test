-CASE ExpressionJoinKeyMerge
-STATEMENT CREATE NODE TABLE Author(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE (:Author {id: 6});
---- ok
-STATEMENT UNWIND [{aid: 6}, {aid: 7}, {aid: 7}] AS r MERGE (a:Author {id: r.aid}) RETURN a.id;
---- 3
6
7
7
-STATEMENT MATCH (a:Author) RETURN a.id;
---- 2
6
7
