-CASE ExpressionJoinKeyCreate
-STATEMENT CREATE NODE TABLE N(id INT64, PRIMARY KEY(id));
---- ok
-STATEMENT CREATE REL TABLE E(FROM N TO N);
---- ok
-STATEMENT UNWIND range(0, 9) AS i CREATE (:N {id: i});
---- ok
-STATEMENT MATCH (a:N), (b:N) WHERE b.id = a.id + 1 CREATE (a)-[:E]->(b);
---- ok
-STATEMENT MATCH (a:N)-[:E]->(b:N) RETURN count(*), sum(b.id - a.id);
---- 1
9|9

-CASE ExpressionJoinKeyChangesState
-STATEMENT CREATE SEQUENCE keySeq;
---- ok
-STATEMENT MATCH (a:person), (b:person) WHERE b.ID = a.ID + nextval('keySeq') * 0 RETURN count(*)
---- 1
8
-STATEMENT RETURN currval('keySeq')
---- 1
8
-STATEMENT MATCH (a:person), (b:person) WHERE b.ID = a.ID + CASE WHEN a.ID >= 0 THEN nextval('keySeq') * 0 ELSE 0 END RETURN count(*)
---- 1
8
-STATEMENT RETURN currval('keySeq')
---- 1
16

