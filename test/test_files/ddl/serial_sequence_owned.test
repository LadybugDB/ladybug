-DATASET CSV empty

--

-CASE DropSequenceOfSerialColumnIsRefused
-SKIP_WASM
-LOG A SERIAL column keeps using its sequence, so dropping the sequence is refused and the table stays writable
-STATEMENT CREATE NODE TABLE A(id SERIAL PRIMARY KEY, v INT64);
---- ok
-STATEMENT CREATE REL TABLE R(FROM A TO A, s SERIAL);
---- ok
-STATEMENT DROP SEQUENCE A_id_serial;
---- error
Binder exception: Cannot drop sequence A_id_serial because it is used by the SERIAL column A.id. Drop the column or its table instead.
-STATEMENT DROP SEQUENCE IF EXISTS A_id_serial;
---- error
Binder exception: Cannot drop sequence A_id_serial because it is used by the SERIAL column A.id. Drop the column or its table instead.
-STATEMENT DROP SEQUENCE R_s_serial;
---- error
Binder exception: Cannot drop sequence R_s_serial because it is used by the SERIAL column R.s. Drop the column or its table instead.
-STATEMENT CREATE (:A {v: 1});
---- ok
-STATEMENT CREATE (:A {v: 2});
---- ok
-STATEMENT MATCH (a:A) RETURN a.id, a.v;
---- 2
0|1
1|2
-STATEMENT DROP TABLE R;
---- ok
-STATEMENT DROP TABLE A;
---- ok
-STATEMENT CALL show_sequences() RETURN count(*);
---- 1
0

-CASE DropSequenceFollowsTheSerialDefaultAfterRename
-SKIP_WASM
-LOG After a rename the column no longer derives the sequence's name, but its default still calls nextval on it
-STATEMENT CREATE NODE TABLE A(k INT64 PRIMARY KEY, s SERIAL);
---- ok
-STATEMENT ALTER TABLE A RENAME s TO t;
---- ok
-STATEMENT DROP SEQUENCE A_s_serial;
---- error
Binder exception: Cannot drop sequence A_s_serial because it is used by the SERIAL column A.t. Drop the column or its table instead.
-STATEMENT ALTER TABLE A DROP t;
---- ok
-LOG The column is gone, so nothing uses the sequence any more
-STATEMENT DROP SEQUENCE A_s_serial;
---- ok

-CASE DropSequenceOfDroppedSerialColumnIsAllowed
-SKIP_WASM
-STATEMENT CREATE NODE TABLE A(k INT64 PRIMARY KEY, s SERIAL);
---- ok
-STATEMENT ALTER TABLE A DROP s;
---- ok
-STATEMENT DROP SEQUENCE A_s_serial;
---- ok

-CASE PlainSequenceCanStillBeDropped
-STATEMENT CREATE SEQUENCE plain;
---- ok
-STATEMENT DROP SEQUENCE plain;
---- ok

-CASE DropSequenceOfSerialColumnIsRefusedAfterImport
-SKIP_WASM
-LOG IMPORT DATABASE restores the sequence with setval, so it stays the table's sequence
-STATEMENT CREATE NODE TABLE A(id SERIAL PRIMARY KEY, v INT64);
---- ok
-STATEMENT CREATE (:A {v: 1});
---- ok
-STATEMENT Export Database "${LBUG_EXPORT_DB_DIRECTORY}_serial_owned/demo-db"
---- ok
-IMPORT_DATABASE "${LBUG_EXPORT_DB_DIRECTORY}_serial_owned/demo-db"
-STATEMENT IMPORT DATABASE "${LBUG_EXPORT_DB_DIRECTORY}_serial_owned/demo-db"
---- ok
-STATEMENT DROP SEQUENCE A_id_serial;
---- error
Binder exception: Cannot drop sequence A_id_serial because it is used by the SERIAL column A.id. Drop the column or its table instead.
-STATEMENT CREATE (:A {v: 2});
---- ok
-STATEMENT MATCH (a:A) RETURN a.id ORDER BY a.id;
---- 2
0
1
