-DATASET CSV empty
--

-CASE CopyNodeRollbackWithExistingRows
-STATEMENT CREATE NODE TABLE P(id INT64, v INT64, PRIMARY KEY (id));
---- ok
-STATEMENT CREATE (:P {id: 0, v: 0});
---- ok
-STATEMENT CREATE (:P {id: 1, v: 1});
---- ok
-STATEMENT COPY P FROM (UNWIND [100, 101, 0] AS i RETURN i, i * 10);
---- error(regex)
Copy exception: Found duplicated primary key value 0, which violates the uniqueness constraint of the primary key column.
-STATEMENT MATCH (p:P) RETURN p.id, p.v ORDER BY p.id;
---- 2
0|0
1|1
-STATEMENT CREATE (:P {id: 7, v: 70});
---- ok
-STATEMENT MATCH (p:P) RETURN p.id, p.v ORDER BY p.id;
---- 3
0|0
1|1
7|70
-STATEMENT MATCH (p:P {id: 7}) RETURN p.id, p.v;
---- 1
7|70
-STATEMENT CHECKPOINT;
---- ok
-STATEMENT MATCH (p:P) RETURN p.id, p.v ORDER BY p.id;
---- 3
0|0
1|1
7|70

-CASE CopyNodeExplicitRollbackWithExistingRows
-STATEMENT CREATE NODE TABLE Q(id INT64, name STRING, PRIMARY KEY (id));
---- ok
-STATEMENT CREATE (:Q {id: 1, name: "alice"});
---- ok
-STATEMENT CREATE (:Q {id: 2, name: "bob"});
---- ok
-STATEMENT BEGIN TRANSACTION;
---- ok
-STATEMENT COPY Q FROM (UNWIND [10, 11] AS i RETURN i, "temp");
---- ok
-STATEMENT ROLLBACK;
---- ok
-STATEMENT MATCH (q:Q) RETURN q.id, q.name ORDER BY q.id;
---- 2
1|alice
2|bob
-STATEMENT CREATE (:Q {id: 3, name: "charlie"});
---- ok
-STATEMENT MATCH (q:Q) RETURN q.id, q.name ORDER BY q.id;
---- 3
1|alice
2|bob
3|charlie
-STATEMENT MATCH (q:Q {id: 3}) RETURN q.id, q.name;
---- 1
3|charlie
-STATEMENT CHECKPOINT;
---- ok
-STATEMENT MATCH (q:Q) RETURN q.id, q.name ORDER BY q.id;
---- 3
1|alice
2|bob
3|charlie
