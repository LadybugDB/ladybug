-DATASET CSV empty
-SKIP_IN_MEM
--

-CASE DoubleNaNFirstSurvivesCheckpoint
-STATEMENT CREATE NODE TABLE T(k INT64, d DOUBLE, PRIMARY KEY(k));
---- ok
-STATEMENT COPY T FROM (UNWIND range(1, 5) AS k RETURN k, CASE WHEN k = 1 THEN CAST('nan' AS DOUBLE) ELSE k * 1.5 END AS d);
---- ok
-STATEMENT CHECKPOINT;
---- ok
-STATEMENT MATCH (t:T) RETURN t.k, t.d ORDER BY t.k;
---- 5
1|nan
2|3.000000
3|4.500000
4|6.000000
5|7.500000

-CASE DoubleNaNAmongEqualValuesSurvivesCheckpoint
-STATEMENT CREATE NODE TABLE R(k INT64, d DOUBLE, PRIMARY KEY(k));
---- ok
-STATEMENT COPY R FROM (UNWIND range(1, 5) AS k RETURN k, CASE WHEN k = 3 THEN CAST('nan' AS DOUBLE) ELSE 5.0 END AS d);
---- ok
-STATEMENT CHECKPOINT;
---- ok
-STATEMENT MATCH (t:R) RETURN t.k, t.d ORDER BY t.k;
---- 5
1|5.000000
2|5.000000
3|nan
4|5.000000
5|5.000000

-CASE DoubleNaNFirstNonNullBehindNulls
-STATEMENT CREATE NODE TABLE N(k INT64, d DOUBLE, PRIMARY KEY(k));
---- ok
-STATEMENT COPY N FROM (UNWIND range(1, 5) AS k RETURN k, CASE WHEN k <= 2 THEN CAST(NULL AS DOUBLE) WHEN k = 3 THEN CAST('nan' AS DOUBLE) ELSE k * 1.5 END AS d);
---- ok
-STATEMENT CHECKPOINT;
---- ok
-STATEMENT MATCH (t:N) RETURN t.k, t.d ORDER BY t.k;
---- 5
1|
2|
3|nan
4|6.000000
5|7.500000

-CASE FloatNaNFirstSurvivesCheckpoint
-STATEMENT CREATE NODE TABLE F(k INT64, f FLOAT, PRIMARY KEY(k));
---- ok
-STATEMENT COPY F FROM (UNWIND range(1, 5) AS k RETURN k, CASE WHEN k = 1 THEN CAST('nan' AS FLOAT) ELSE CAST(k * 1.5 AS FLOAT) END AS f);
---- ok
-STATEMENT CHECKPOINT;
---- ok
-STATEMENT MATCH (t:F) RETURN t.k, t.f ORDER BY t.k;
---- 5
1|nan
2|3.000000
3|4.500000
4|6.000000
5|7.500000
