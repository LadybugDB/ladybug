-DATASET CSV tinysnb

--

-CASE Random
-STATEMENT RETURN RANDOM()
---- ok
-STATEMENT RETURN setseed(0.2)
---- ok
-STATEMENT RETURN RANDOM()
---- 1
0.910543
-STATEMENT RETURN RANDOM()
---- 1
0.650728
-STATEMENT RETURN RANDOM()
---- 1
0.111587
-STATEMENT RETURN setseed(0.7)
---- ok
-STATEMENT RETURN RANDOM()
---- 1
0.545887
-STATEMENT RETURN setseed(0.2)
---- ok
-STATEMENT RETURN RANDOM()
---- 1
0.910543
-STATEMENT RETURN RANDOM()
---- 1
0.650728
-STATEMENT RETURN RANDOM()
---- 1
0.111587
-STATEMENT MATCH (p:person) RETURN p.id, random() limit 2
---- 2
0|0.528393
2|0.708328
-STATEMENT MATCH (p:person)-[:knows]->(p1:person) RETURN p.id, p1.id, random() as r ORDER BY r LIMIT 3
---- ok

-CASE RandomCallsAreIndependent
-STATEMENT RETURN setseed(0.2)
---- ok
-STATEMENT RETURN random() AS a, random() AS b
---- 1
0.910543|0.650728
-STATEMENT WITH random() AS a, random() AS b RETURN a <> b
---- 1
True
-STATEMENT WITH gen_random_uuid() AS u1, gen_random_uuid() AS u2 RETURN u1 <> u2
---- 1
True
-STATEMENT WITH gen_random_uuid() AS u RETURN u = u
---- 1
True

-CASE SetseedNotAllowedInDefault
-STATEMENT CREATE NODE TABLE T(id INT64 PRIMARY KEY, x INT32 DEFAULT setseed(0.2));
---- error
Binder exception: setseed is not allowed in a DEFAULT expression.
-STATEMENT CREATE NODE TABLE T(id INT64 PRIMARY KEY);
---- ok
-STATEMENT ALTER TABLE T ADD y INT32 DEFAULT 1 + setseed(0.2);
---- error
Binder exception: setseed is not allowed in a DEFAULT expression.

-CASE SetseedRunsPerRow
-STATEMENT UNWIND [1, 2] AS x RETURN x, setseed(0.2) AS s, random() AS r;
---- 2
1||0.910543
2||0.910543
