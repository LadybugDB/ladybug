0|a|INT32|NULL|True
1|b|INT32|NULL|False
2|c|INT32|NULL|False
-STATEMENT COMMIT;
---- ok
-STATEMENT ALTER TABLE t DROP c;
---- ok
-STATEMENT CALL table_info('t') RETURN *;
