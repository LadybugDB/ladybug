---- ok
-STATEMENT CREATE NODE TABLE z7(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z8(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z9(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z10(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z11(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z12(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z13(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z14(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z15(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z16(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z17(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z18(id INT64 PRIMARY KEY);
---- ok
-STATEMENT CREATE NODE TABLE z19(id INT64 PRIMARY KEY);
