-DATASET CSV empty

--

-CASE Issue1692NegativeIntervalDivision
# Dividing a negative interval used unsigned arithmetic, producing garbage
# (e.g. 119304647 years). Signed division is now used throughout.

-STATEMENT RETURN (interval('1 day') - interval('1 day 1 month')) / 3 AS x;
---- 1
-10 days
-STATEMENT RETURN (interval('0 days') - interval('1 month')) / 3;
---- 1
-10 days
-STATEMENT RETURN interval('3 days') / -1;
---- 1
-3 days
-STATEMENT RETURN (interval('0 days') - interval('6 days')) / -2;
---- 1
3 days
