-DATASET CSV empty

--

-CASE Issue1694IntervalDateTimeFunctions
# Interval constructors, DATE + integer, and date_part/date_trunc on
# intervals either wrapped silently or reached UNREACHABLE_CODE (process
# abort). Wrapping inputs now raise; unsupported interval date_part fields
# raise instead of aborting; date_trunc century/millennium now agrees with
# date_part (PG semantics: 2024 is in the 21st century starting 2001-01-01).

-STATEMENT RETURN to_years(1000000000);
---- error
Overflow exception: Interval value is out of range
-STATEMENT RETURN to_months(3000000000);
---- error
Overflow exception: Interval value is out of range
-STATEMENT RETURN to_days(3000000000);
---- error
Overflow exception: Interval value is out of range
-STATEMENT RETURN to_hours(9223372036854775807);
---- error
Overflow exception: Interval value is out of range
-STATEMENT RETURN to_minutes(153722867280912931);
---- error
Overflow exception: Interval value is out of range
-STATEMENT RETURN to_seconds(9223372036854775807);
---- error
Overflow exception: Interval value is out of range
-STATEMENT RETURN to_milliseconds(9223372036854775807);
---- error
Overflow exception: Interval value is out of range
-STATEMENT RETURN epoch_ms(9223372036854775807);
---- error
Overflow exception: Value 9223372036854775807 * 1000 is not within INT64 range.
-STATEMENT RETURN date('2024-03-15') + 3000000000;
---- error
Overflow exception: Date value is out of range
-STATEMENT RETURN date('2024-03-15') + 9223372036854775807;
---- error
Overflow exception: Date value is out of range
-STATEMENT RETURN date('2024-03-15') - 3000000000;
---- error
Overflow exception: Date value is out of range
-STATEMENT RETURN 3000000000 + date('2024-03-15');
---- error
Overflow exception: Date value is out of range
-STATEMENT RETURN date_part('dow', interval('1 day'));
---- error
Conversion exception: date_part specifier is not supported for INTERVAL input.
-STATEMENT RETURN date_part('week', interval('1 day'));
---- error
Conversion exception: date_part specifier is not supported for INTERVAL input.
-STATEMENT RETURN date_part('century', date('2024-03-15')), date_trunc('century', date('2024-03-15'));
---- 1
21|2001-01-01
-STATEMENT RETURN date_part('millennium', date('2024-03-15')), date_trunc('millennium', date('2024-03-15'));
---- 1
3|2001-01-01
-STATEMENT RETURN date_trunc('century', date('1900-01-01')), date_trunc('century', date('2000-12-31')), date_trunc('century', date('2001-01-01'));
---- 1
1801-01-01|1901-01-01|2001-01-01
-STATEMENT RETURN date_trunc('millennium', date('2000-12-31')), date_trunc('millennium', date('2001-01-01'));
---- 1
1001-01-01|2001-01-01
